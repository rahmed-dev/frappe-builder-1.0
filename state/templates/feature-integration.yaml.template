    #   method: "GET" | "POST" | "PUT" | "DELETE"
    #   purpose: ""
    #   status: "planned" | "completed"

  data_mappings: []
    # - source: ""
    #   target: ""
    #   transformation: ""
    #   status: "planned" | "completed"

  webhooks: []
    # - event: ""
    #   url: ""
    #   purpose: ""
    #   status: "planned" | "completed"

  scheduled_tasks: []
    # - task: ""
    #   schedule: ""
    #   purpose: ""
    #   status: "planned" | "completed"

decision_count: 0     # Incremented when decisions.yaml entries reference this feature
