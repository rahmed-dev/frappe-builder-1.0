# Feature Inventory
# Token target: scales with project size (~30 tokens per feature entry)
# Loaded on demand only: Resume mode, status checks, reporting
# NOT loaded on every workflow step - kept separate from session state
# Generated by Frappe-Builder | Version: 1.0

features: {}
  # Format per entry:
  #
  # {feature-id}:
  #   type: ""        # doctype_customization | new_doctype | report | page | integration | bugfix | ad-hoc
  #   status: ""      # planned | in-progress | completed | on-hold | blocked
  #   progress: ""    # "X/Y" e.g. "5/9"
  #   started: ""     # YYYY-MM-DD
  #   detail: ""      # path: "features/{feature-id}.yaml"
  #   notes: ""       # one sentence summary — keep it short
  #
  # Example:
  #
  # sales-invoice-enhancements:
  #   type: "doctype_customization"
  #   status: "in-progress"
  #   progress: "5/9"
  #   started: "2026-02-05"
  #   detail: "features/sales-invoice-enhancements.yaml"
  #   notes: "Credit validation done, discount calc in progress"
  #
  # asset-maintenance-request:
  #   type: "new_doctype"
  #   status: "planned"
  #   progress: "0/9"
  #   started: "2026-02-19"
  #   detail: "features/asset-maintenance-request.yaml"
  #   notes: ""
